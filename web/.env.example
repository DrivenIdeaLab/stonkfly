# How the console reaches a run. Never set credentials here: the console is a
# read-only observer and handles no keys, portfolios or orders.

# fixture | file | http
STONKFLY_SOURCE=fixture

# file mode: read run directories straight off disk (same container as the worker)
STONKFLY_RUNS_DIR=/var/lib/stonkfly/runs

# http mode: ask the stonkfly-observer API instead (recommended deployment)
STONKFLY_OBSERVER_URL=http://10.0.0.42:8787

# Which run to open by default
STONKFLY_RUN=paper

# Bind address / port for `next start`
PORT=3000
HOSTNAME=0.0.0.0
